---
export interface Props {
  coverSrc: string;
  title: string;
  subtitle?: string;
  description?: string;
}
const { title, subtitle, description }: Props = Astro.props;

const editions = [
  {
    label:    'V1',
    name:     'First Edition',
    coverSrc: '/BookIntroductionPage/images/covers/cover1.png',
    pdfUrl:   '/BookIntroductionPage/pdfs/写给同学的IT书_电子版.pdf',
    tint:     '#3b82f6',
  },
  {
    label:    'V2',
    name:     'Second Edition',
    coverSrc: '/BookIntroductionPage/images/covers/cover2.png',
    pdfUrl:   '/BookIntroductionPage/pdfs/v2.pdf',
    tint:     '#f97316',
  },
  {
    label:    'V3',
    name:     'Third Edition',
    coverSrc: '/BookIntroductionPage/images/covers/cover3.png',
    pdfUrl:   '/BookIntroductionPage/pdfs/v3.pdf',
    tint:     '#a855f7',
  },
];
---

<section
  id="hero"
  class="section section--full relative overflow-hidden flex items-center"
  style="--edition:0"
>

  <div class="container-narrow my-auto relative z-10 w-full flex flex-col justify-center">
    <div class="hero-grid grid grid-cols-1 lg:grid-cols-phi gap-5 lg:gap-16 items-center">

      <!-- ── Edition stage: swipeable rail on small screens, fanned deck on desktop ── -->
      <div class="edition-stage">
        <!-- Ambient glow — tinted by the active edition -->
        <div class="edition-aura" aria-hidden="true"></div>

        <div id="edition-rail" class="edition-rail" role="group" aria-roledescription="carousel" aria-label="Book editions">
          {editions.map((ed, i) => (
            <button
              type="button"
              class="edition-slide"
              data-label={ed.label}
              data-name={ed.name}
              data-pdf={ed.pdfUrl}
              style={`--slide-tint:${ed.tint};--d:${Math.min(i, 1)};--a:${Math.min(i, 1)};--o:${i};--oa:${i};z-index:${10 - i}`}
              aria-label={`Show ${ed.name}`}
              aria-current={i === 0 ? 'true' : undefined}
            >
              <img
                src={ed.coverSrc}
                alt={`${title} — ${ed.name} cover`}
                class="edition-slide__img"
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
                draggable="false"
              />
              <span class="edition-slide__sheen" aria-hidden="true"></span>
            </button>
          ))}
        </div>

        <div id="edition-switch" class="edition-switch" role="radiogroup" aria-label="Choose edition">
          <span class="edition-switch__thumb" aria-hidden="true"></span>
          {editions.map((ed, i) => (
            <button
              type="button"
              role="radio"
              class="edition-switch__opt"
              aria-checked={i === 0 ? 'true' : 'false'}
              aria-label={ed.name}
              tabindex={i === 0 ? 0 : -1}
            >{ed.label}</button>
          ))}
        </div>
      </div>

      <!-- ── Text content ── -->
      <div class="flex flex-col space-y-5 lg:space-y-10 lg:pl-8 relative text-center lg:text-left">
        <div class="text-content">
          <!-- Eyebrow follows the active edition -->
          <p id="edition-name" class="edition-eyebrow hidden lg:block animate-fade-in-up">
            {editions[0].label} · {editions[0].name}
          </p>

          <h1 class="hero-title text-4xl sm:text-5xl lg:text-7xl font-black tracking-tight text-black leading-tight animate-fade-in-up">
            {title}
          </h1>

          {subtitle && (
            <p class="hero-subtitle mt-3 lg:mt-8 text-base sm:text-xl lg:text-2xl text-slate-600 font-medium animate-slide-in-left" style="animation-delay: 0.2s;">
              {subtitle}
            </p>
          )}
          {description && (
            <p class="hero-description mt-3 lg:mt-8 text-sm sm:text-lg lg:text-xl leading-relaxed text-slate-500 lg:text-slate-600 max-w-lg mx-auto lg:mx-0 animate-slide-in-left" style="animation-delay: 0.4s;">
              {description}
            </p>
          )}
        </div>

        <!-- Buttons: Read Online leads and follows the active edition -->
        <div class="hero-buttons grid grid-cols-2 gap-3 lg:flex lg:flex-row lg:flex-wrap lg:gap-4 lg:pt-4 animate-fade-in-up" style="animation-delay: 0.6s;">
          <button
            id="readOnlineBtn"
            class="read-btn btn-primary group justify-center col-span-2 text-base xl:text-lg px-4 xl:px-6 py-4 lg:py-5 text-white flowing-element whitespace-nowrap"
            data-pdf={editions[0].pdfUrl}
          >
            <span class="relative z-10">Read <span id="read-edition">{editions[0].label}</span> Online</span>
          </button>
          <a href="#details" class="learn-btn btn-primary group justify-center text-base xl:text-lg px-4 xl:px-6 py-3 lg:py-5 shadow-layer-3 hover:shadow-layer-5 text-white flowing-element whitespace-nowrap">
            <span class="relative z-10">Learn More</span>
            <span class="ml-3 transform transition-transform group-hover:translate-x-2 relative z-10">→</span>
          </a>
          <a href="#reviews" class="reviews-btn btn-outline group justify-center text-base xl:text-lg px-4 xl:px-6 py-3 lg:py-5 shadow-layer-2 hover:shadow-layer-4 border-2 flowing-element whitespace-nowrap">
            <span>View Reviews</span>
            <span class="ml-3 transform transition-transform group-hover:translate-x-2">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
(function heroEditions() {
  const hero = document.getElementById('hero');
  const rail = document.getElementById('edition-rail');
  if (!hero || !rail) return;

  const slides      = Array.from(rail.querySelectorAll('.edition-slide'));
  const switchOpts  = Array.from(document.querySelectorAll('.edition-switch__opt'));
  const readBtn     = document.getElementById('readOnlineBtn');
  const readEdition = document.getElementById('read-edition');
  const editionName = document.getElementById('edition-name');

  // Below lg the covers are a scrollable rail; from lg up they are a fanned deck
  const railLayout = window.matchMedia('(max-width: 1023.98px)');

  let currentEdition = 0;
  let railTicking    = false;
  let railTarget     = null; // edition a programmatic scroll is heading to

  // ── Deck crossfade (desktop) ─────────────────────────────────────────────────
  const FADE_MS = 640;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let stackTimer = 0;

  function restack(idx) {
    slides.forEach((slide, i) => { slide.style.zIndex = String(10 - Math.abs(i - idx)); });
  }

  // The outgoing cover stays on top and dissolves, revealing the incoming one
  // beneath it; once it is invisible it drops to its new place in the deck and
  // fades back in. The stacking order never changes while it can be seen.
  function crossfade(idx, prev) {
    const outgoing = slides[prev];
    slides.forEach((slide) => slide.getAnimations().forEach((a) => {
      if (!(a instanceof CSSTransition)) a.cancel();
    }));
    restack(idx);
    outgoing.style.zIndex = '11';
    outgoing.animate(
      [{ opacity: 1 }, { opacity: 0, offset: 0.5 }, { opacity: 1 }],
      { duration: FADE_MS, easing: 'ease-in-out' }
    );
    clearTimeout(stackTimer);
    stackTimer = setTimeout(() => restack(idx), FADE_MS / 2);
  }

  // ── Apply edition state to the DOM ───────────────────────────────────────────
  function applyEdition(idx, prev) {
    const ed = slides[idx].dataset;

    // The whole site re-themes from this attribute (palettes live in global.css)
    document.documentElement.dataset.edition = String(idx);
    hero.style.setProperty('--edition', String(idx));

    // Deck position of every cover relative to the active one: earlier editions
    // fan out to its left, later editions to its right
    slides.forEach((slide, i) => {
      const offset = i - idx;
      slide.style.setProperty('--o', String(offset));
      slide.style.setProperty('--oa', String(Math.abs(offset)));
      if (i === idx) slide.setAttribute('aria-current', 'true');
      else slide.removeAttribute('aria-current');
    });

    if (!railLayout.matches && !reducedMotion.matches) {
      crossfade(idx, prev);
    } else {
      clearTimeout(stackTimer);
      restack(idx);
    }

    switchOpts.forEach((opt, i) => {
      opt.setAttribute('aria-checked', i === idx ? 'true' : 'false');
      opt.tabIndex = i === idx ? 0 : -1;
    });

    if (readBtn) readBtn.dataset.pdf = ed.pdf;
    if (readEdition) readEdition.textContent = ed.label;
    if (editionName) editionName.textContent = `${ed.label} · ${ed.name}`;
  }

  function setEdition(idx) {
    if (idx === currentEdition) return;
    const prev = currentEdition;
    currentEdition = idx;
    applyEdition(idx, prev);
  }

  // ── Rail (small screens) ─────────────────────────────────────────────────────
  function slideScrollLeft(idx) {
    const slide = slides[idx];
    return slide.offsetLeft - (rail.clientWidth - slide.offsetWidth) / 2;
  }

  function goToEdition(idx, smooth = true) {
    setEdition(idx);
    if (!railLayout.matches) return;
    railTarget = idx;
    rail.scrollTo({ left: slideScrollLeft(idx), behavior: smooth ? 'smooth' : 'auto' });
  }

  // Scale / tilt each cover by its distance from the rail centre, and
  // promote whichever cover is nearest the centre to the active edition.
  function updateRail() {
    railTicking = false;
    if (!railLayout.matches) return;

    const center = rail.scrollLeft + rail.clientWidth / 2;
    const step   = slides.length > 1 ? slides[1].offsetLeft - slides[0].offsetLeft : 1;
    let nearest = 0;
    let best    = Infinity;

    slides.forEach((slide, i) => {
      const offset = slide.offsetLeft + slide.offsetWidth / 2 - center;
      const d = Math.max(-1, Math.min(1, offset / step));
      slide.style.setProperty('--d', d.toFixed(3));
      slide.style.setProperty('--a', Math.abs(d).toFixed(3));
      if (Math.abs(offset) < best) { best = Math.abs(offset); nearest = i; }
    });

    if (railTarget !== null) {
      if (nearest === railTarget) railTarget = null;
      return;
    }
    setEdition(nearest);
  }

  rail.addEventListener('scroll', function () {
    if (railTicking) return;
    railTicking = true;
    requestAnimationFrame(updateRail);
  }, { passive: true });

  // A finger on the rail always wins over a programmatic scroll
  rail.addEventListener('touchstart', function () { railTarget = null; }, { passive: true });

  // ── Controls ─────────────────────────────────────────────────────────────────
  slides.forEach((slide, i) => slide.addEventListener('click', () => goToEdition(i)));

  switchOpts.forEach((opt, i) => {
    opt.addEventListener('click', () => goToEdition(i));
    opt.addEventListener('keydown', (e) => {
      const dir = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1
                : e.key === 'ArrowLeft'  || e.key === 'ArrowUp'   ? -1 : 0;
      if (!dir) return;
      e.preventDefault();
      const next = Math.max(0, Math.min(switchOpts.length - 1, i + dir));
      goToEdition(next);
      switchOpts[next].focus();
    });
  });

  // Keep the rail aligned with the active edition across breakpoint / size changes
  const realign = () => { goToEdition(currentEdition, false); updateRail(); };
  railLayout.addEventListener('change', realign);
  window.addEventListener('resize', realign);
  realign();

  // ── Read Online button ───────────────────────────────────────────────────────
  if (readBtn) {
    readBtn.addEventListener('click', function () {
      const pdfUrl = readBtn.dataset.pdf;
      if (!pdfUrl) return;
      const tab = window.open(pdfUrl, '_blank');
      if (!tab) alert('Please allow pop-ups for this site to open the PDF in a new tab.');
    });
  }
})();
</script>

<style>
  /* Edition colours come from the site theme, which follows the active edition */
  #hero {
    --tint: rgb(var(--theme-500));
    --tint-strong: rgb(var(--theme-600));
  }

  /* ── Edition stage ───────────────────────────────────────────────────── */
  .edition-stage {
    position: relative;
    /* Full-bleed: break out of the container padding so covers can peek */
    width: 100vw;
    margin-left: calc(50% - 50vw);
  }

  .edition-aura {
    position: absolute;
    left: 50%;
    top: 8%;
    width: min(80vw, 26rem);
    aspect-ratio: 1;
    transform: translateX(-50%);
    border-radius: 9999px;
    background: var(--tint);
    opacity: 0.22;
    filter: blur(64px);
    transition: background-color 700ms cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
  }

  .edition-rail {
    --cover-h: clamp(220px, 40svh, 420px);
    --cover-w: calc(var(--cover-h) / 1.414); /* covers are A4 */
    position: relative;
    display: flex;
    gap: 1.25rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    padding: 0.75rem calc(50% - var(--cover-w) / 2) 2.25rem;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .edition-rail::-webkit-scrollbar {
    display: none;
  }

  .edition-slide {
    position: relative;
    flex: 0 0 var(--cover-w);
    height: var(--cover-h);
    padding: 0;
    border: 0;
    border-radius: 1.25rem;
    overflow: hidden;
    background: #e2e8f0;
    scroll-snap-align: center;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    /* --d: signed distance from the rail centre (-1…1), --a: |--d| — set by JS on scroll */
    transform: perspective(900px) rotateY(calc(var(--d, 0) * -16deg)) scale(calc(1 - var(--a, 0) * 0.12));
    opacity: calc(1 - var(--a, 0) * 0.45);
    box-shadow:
      0 0 0 1px rgb(15 23 42 / 0.06),
      0 12px 24px -10px rgb(15 23 42 / 0.25),
      0 28px 44px -20px color-mix(in srgb, var(--slide-tint) calc((1 - var(--a, 0)) * 70%), transparent);
    will-change: transform;
  }

  .edition-slide:focus-visible {
    outline: 2px solid var(--tint-strong);
    outline-offset: 4px;
  }

  .edition-slide__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
    -webkit-user-drag: none;
  }

  /* Soft diagonal highlight, like light catching a printed cover */
  .edition-slide__sheen {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(115deg, rgb(255 255 255 / 0.28) 0%, transparent 38%);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.35);
    pointer-events: none;
  }

  /* ── Edition switch (segmented control) ──────────────────────────────── */
  .edition-switch {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    width: min(15rem, 70vw);
    margin: 0 auto;
    padding: 4px;
    border-radius: 9999px;
    background: color-mix(in srgb, rgb(var(--theme-100) / 0.9) 58%, rgb(255 255 255 / 0.75));
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: inset 0 0 0 1px rgb(var(--theme-300) / 0.35), var(--shadow-layer-2);
    transition: background-color 900ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .edition-switch__thumb {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 4px;
    width: calc((100% - 8px) / 3);
    border-radius: 9999px;
    background: var(--tint-strong);
    box-shadow: 0 8px 16px -8px var(--tint-strong);
    transform: translateX(calc(var(--edition, 0) * 100%));
    transition:
      transform 450ms cubic-bezier(0.34, 1.3, 0.64, 1),
      background-color 450ms cubic-bezier(0.4, 0, 0.2, 1),
      box-shadow 450ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .edition-switch__opt {
    position: relative;
    z-index: 1;
    height: 2.25rem;
    border: 0;
    background: none;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #64748b;
    cursor: pointer;
    transition: color 300ms ease;
    -webkit-tap-highlight-color: transparent;
  }

  .edition-switch__opt[aria-checked='true'] {
    color: #fff;
  }

  .edition-switch__opt:focus-visible {
    outline: 2px solid var(--tint-strong);
    outline-offset: 2px;
    border-radius: 9999px;
  }

  /* ── Text ────────────────────────────────────────────────────────────── */
  .edition-eyebrow {
    margin-bottom: 1.25rem;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--tint-strong);
    transition: color 450ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Read Online follows the active edition's colour */
  .read-btn {
    background-color: var(--tint-strong);
    box-shadow: 0 16px 28px -14px var(--tint-strong);
    transition:
      background-color 450ms cubic-bezier(0.4, 0, 0.2, 1),
      box-shadow 450ms cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.6s cubic-bezier(0.4, 0, 0.2, 1),
      filter 300ms ease;
  }

  .read-btn:hover {
    filter: brightness(0.92);
  }

  /* Equal-width digits: "V1" and "V2" take the same space, so the button
     (and everything laid out after it) does not shift when the edition changes */
  #read-edition,
  .edition-eyebrow {
    font-variant-numeric: tabular-nums;
  }

  /* Learn More / View Reviews take the same edition colour, one step lighter */
  .learn-btn {
    background-color: var(--tint);
    transition:
      background-color 450ms cubic-bezier(0.4, 0, 0.2, 1),
      box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .learn-btn:hover {
    background-color: var(--tint-strong);
  }

  .reviews-btn {
    color: var(--tint-strong);
    border-color: color-mix(in srgb, var(--tint) 45%, transparent);
    transition:
      color 450ms cubic-bezier(0.4, 0, 0.2, 1),
      border-color 450ms cubic-bezier(0.4, 0, 0.2, 1),
      background-color 300ms ease,
      box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .reviews-btn:hover {
    background-color: color-mix(in srgb, var(--tint) 10%, transparent);
    border-color: color-mix(in srgb, var(--tint) 70%, transparent);
  }

  /* ── Entrance animations ─────────────────────────────────────────────── */
  .animate-fade-in-up {
    opacity: 0;
    animation: fadeInUp 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  .animate-slide-in-left {
    opacity: 0;
    animation: slideInLeft 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0);    }
  }

  @keyframes slideInLeft {
    from { opacity: 0; transform: translateX(-20px); }
    to   { opacity: 1; transform: translateX(0);     }
  }

  /* ── Small screens: keep the whole hero within one screen ────────────── */
  @media (max-width: 1023.98px) and (max-height: 859px) {
    .hero-description {
      display: none;
    }
  }

  @media (max-width: 1023.98px) and (max-height: 699px) {
    .edition-rail {
      --cover-h: clamp(180px, 32svh, 420px);
    }
  }

  /* ── Desktop: the rail becomes a fanned deck of covers ───────────────── */
  @media (min-width: 1024px) {
    /* Fixed golden-ratio tracks: plain `fr` columns grow with their content,
       which let a wider button label resize both columns */
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.618fr);
    }

    /* Sized so all three buttons share one row inside the fixed text column */
    .hero-buttons > * {
      padding-inline: 1rem;
    }
  }

  @media (min-width: 1280px) {
    .hero-buttons > * {
      padding-inline: 1.5rem;
    }
  }

  @media (min-width: 1024px) {

    .edition-stage {
      width: auto;
      margin-left: 0;
      container-type: inline-size;
    }

    /* Deck size: driven by viewport height, but capped by the column width
       (the fan is ~1.4× as wide as one cover) so it never runs off-screen */
    .edition-stage > * {
      --deck-w: min(clamp(320px, 56vh, 560px) / 1.414, 72cqw + 22px);
      --deck-h: calc(var(--deck-w) * 1.414);
    }

    .edition-aura {
      top: 12%;
      width: 24rem;
    }

    /* The covers fan out in edition order, left to right. The deck slides
       against the active edition (V1 sits left, V3 sits right) so the whole
       fan stays centred in its column instead of spilling into the text. */
    .edition-rail {
      --cover-h: var(--deck-h);
      --cover-w: var(--deck-w);
      --fan-step: 11%;
      display: block;
      width: var(--cover-w);
      height: var(--cover-h);
      margin: 0 auto 2.75rem;
      padding: 0;
      overflow: visible;
      scroll-snap-type: none;
      transform: translateX(calc((var(--edition, 0) - 1) * var(--fan-step)));
      transition: transform 700ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    .edition-slide {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border-radius: 1.5rem;
      opacity: 1;
      transform-origin: 50% 100%;
      /* --o: edition offset from the active cover (negative = left), --oa: |--o| — set by JS */
      transform:
        translateX(calc(var(--o, 0) * var(--fan-step)))
        rotate(calc(var(--o, 0) * 4deg - 2deg))
        scale(calc(1 - var(--oa, 0) * 0.07));
      filter: brightness(calc(1 - var(--oa, 0) * 0.05));
      box-shadow:
        0 0 0 1px rgb(15 23 42 / 0.06),
        0 20px 32px -14px rgb(15 23 42 / 0.28),
        0 40px 60px -28px color-mix(in srgb, var(--slide-tint) calc((1 - min(var(--oa, 0), 1)) * 75%), transparent);
      transition:
        transform 700ms cubic-bezier(0.2, 0.8, 0.2, 1),
        filter 500ms ease,
        box-shadow 500ms ease;
    }

    /* Covers waiting in the deck lean out a little when pointed at */
    .edition-slide:not([aria-current]):hover {
      filter: brightness(1);
      transform:
        translateX(calc(var(--o, 0) * var(--fan-step)))
        translateY(-2.5%)
        rotate(calc(var(--o, 0) * 4deg - 2deg))
        scale(calc(1 - var(--oa, 0) * 0.07));
    }

    .edition-slide[aria-current] {
      cursor: default;
    }
  }

  /* ── Reduced motion ──────────────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .edition-aura,
    .edition-slide,
    .edition-switch__thumb,
    .read-btn,
    .learn-btn,
    .reviews-btn {
      transition: none;
    }
  }

  @media (prefers-reduced-motion: reduce) and (max-width: 1023.98px) {
    .edition-slide {
      transform: none;
    }
  }
</style>
